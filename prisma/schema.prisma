generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @default("")
  access_token      String? @default("")
  expires_at        Int?
  token_type        String? @default("")
  scope             String? @default("")
  id_token          String? @default("")
  session_state     String? @default("")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  predictions   Prediction[]
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id
  name      String
  type      String   @default("OFFICIAL") // OFFICIAL | PRACTICE
  isActive  Boolean  @default(true)
  titlesLeaderboardVisible Boolean @default(true)
  createdAt DateTime @default(now())
  seasons   Season[]
}

model Season {
  id                String   @id @default(cuid())
  name              String
  year              Int
  logo              String   @default("/gscl-logo.png")
  isActive          Boolean  @default(true)
  scheduleAnnounced Boolean  @default(false)
  winnerId          String?  @default("")
  runnerUpId        String   @default("")
  seasonQuizLocked  Boolean  @default(false)
  isLocked          Boolean  @default(false)
  lockedAt          DateTime?
  lockedReason      String   @default("")
  workspaceId       String   @default("official")
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())
  teams             Team[]
  matches           Match[]
  snapshots         SeasonSnapshot[]
  transfers         PlayerTransfer[]
  captaincies       TeamCaptaincy[]
  penalties         LeaguePenalty[]
  fairPlayRecords   FairPlayRecord[]
  awards            SeasonAward[]
  honors            TeamHonor[]
  seasonQuizzes     SeasonQuiz[]
  seasonQuizStandings SeasonQuizStanding[]
  playerOfSeasonVotes PlayerOfSeasonVote[]

  @@unique([name, year, workspaceId])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  shortName   String
  logo        String   @default("/placeholder-team.png")
  color       String   @default("#1e3a5f")
  captainName String   @default("")
  headCoach   String   @default("")
  location    String   @default("")
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  players     Player[]
  matches1    Match[]  @relation("Team1Matches")
  matches2    Match[]  @relation("Team2Matches")
  captaincies TeamCaptaincy[]
  penalties   LeaguePenalty[]
  fairPlay    FairPlayRecord[]
  honors      TeamHonor[]
  createdAt   DateTime @default(now())
}

model Player {
  id            String  @id @default(cuid())
  name          String
  role          String  @default("Batsman")
  battingStyle  String  @default("Right-handed")
  bowlingStyle  String  @default("Right-arm fast")
  photo         String  @default("/placeholder-player.svg")
  isCaptain     Boolean @default(false)
  jerseyNumber  Int?
  status        String  @default("available")
  teamId        String
  team          Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  runs            Int     @default(0)
  ballsFaced      Int     @default(0)
  fours           Int     @default(0)
  sixes           Int     @default(0)
  threes          Int     @default(0)
  dotBalls        Int     @default(0)
  ones            Int     @default(0)
  twos            Int     @default(0)
  fifties         Int     @default(0)
  hundreds        Int     @default(0)
  highestScore    Int     @default(0)
  highestScoreNotOut Boolean @default(false)
  notOuts         Int     @default(0)
  dismissals      Int     @default(0)
  ducks           Int     @default(0)
  matchesPlayed   Int     @default(0)
  wickets         Int     @default(0)
  ballsBowled     Int     @default(0)
  runsConceded    Int     @default(0)
  maidens         Int     @default(0)
  wides           Int     @default(0)
  noBalls         Int     @default(0)
  fiveWickets     Int     @default(0)
  fourWickets     Int     @default(0)
  hattricks       Int     @default(0)
  bestBowlingWickets Int  @default(0)
  bestBowlingRuns    Int  @default(0)
  bestBowlingBalls   Int  @default(0)
  catches         Int     @default(0)
  stumpings       Int     @default(0)
  runOuts         Int     @default(0)
  timesBowled     Int     @default(0)
  timesCaught     Int     @default(0)
  timesLbw        Int     @default(0)
  timesStumped    Int     @default(0)
  timesRunOut     Int     @default(0)


  performances PlayerMatch[]
  squadMembers SquadMember[]
  potmVotes     PotmVote[]
  transfers     PlayerTransfer[]
  playerOfSeasonVotes PlayerOfSeasonVote[]

  createdAt DateTime @default(now())

  @@unique([teamId, name])
}

model Match {
  id            String   @id @default(cuid())
  seasonId      String
  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team1Id       String
  team1         Team     @relation("Team1Matches", fields: [team1Id], references: [id])
  team2Id       String
  team2         Team     @relation("Team2Matches", fields: [team2Id], references: [id])
  matchNo       Int      @default(0)
  stage         String   @default("league")
  date          DateTime
  venue         String   @default("Main Stadium")
  status        String   @default("upcoming")
  result        String   @default("")
  team1Score    String   @default("")
  team2Score    String   @default("")
  tossWinner    String   @default("")
  tossDecision  String   @default("")
  manOfMatch    String   @default("")
  winnerTeamId  String?
  youtubeUrl    String   @default("")
  customHighlights String   @default("")
  superOverT1Runs Int    @default(0)
  superOverT1Wkts Int    @default(0)
  superOverT2Runs Int    @default(0)
  superOverT2Wkts Int    @default(0)
  inningsBreak    Boolean @default(false)
  umpire1        String   @default("")
  umpire2        String   @default("")
  thirdUmpire    String   @default("")
  matchReferee   String   @default("")
  officialScorer String   @default("")
  tossTime       String   @default("")
  matchStartTime String   @default("")
  matchEndTime   String   @default("")
  delayReason    String   @default("")
  abandonReason   String @default("")
  abandonDescription String @default("")
  attendance     Int     @default(0)
  dls            Boolean @default(false)
  isSquadLocked  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  predictions   Prediction[]
  innings       Inning[]
  performances  PlayerMatch[]
  quizzes       Quiz[]
  potmVotes     PotmVote[]
  ballEvents    BallEvent[]
  superOvers    SuperOverInnings[]
  notes         MatchNotes?

  @@index([status])
  @@index([seasonId])
  @@index([team1Id])
  @@index([team2Id])
  @@index([seasonId, winnerTeamId])
}

model Inning {
  id       String @id @default(cuid())
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId   String
  runs     Int    @default(0)
  wickets  Int    @default(0)
  balls    Int    @default(0)
  extras   Int    @default(0)
  ballsData String @default("[]")
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([matchId, teamId])
}

model PlayerMatch {
  id         String @id @default(cuid())
  playerId   String
  player     Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  matchId    String
  match      Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId     String

  battingRuns    Int @default(0)
  ballsFaced     Int @default(0)
  fours          Int @default(0)
  sixes          Int @default(0)
  ones           Int @default(0)
  twos           Int @default(0)
  isOut          Boolean @default(false)
  wicketsLost    Int     @default(0)
  dismissalType  String @default("")
  dismissedByBowlerId  String @default("")
  dismissedByFielderId String @default("")
  secondDismissalType  String @default("")
  secondDismissedByBowlerId String @default("")
  secondDismissedByFielderId String @default("")

  bowlingWickets    Int @default(0)
  bowlingRuns       Int @default(0)
  ballsBowled       Int @default(0)
  maidens           Int @default(0)
  isBowled          Boolean @default(false)
  wides             Int @default(0)
  noBalls           Int @default(0)
  threes            Int @default(0)
  dotBalls          Int @default(0)
  hattricks         Int @default(0)

  catches     Int @default(0)
  stumpings   Int @default(0)
  runOuts     Int @default(0)

  createdAt DateTime @default(now())

  @@unique([playerId, matchId])
  @@index([matchId])
  @@index([playerId])
  @@index([teamId])
}

model Prediction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId         String
  match           Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  predictedTeamId String
  createdAt       DateTime @default(now())
}

model News {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  excerpt   String   @default("")
  image     String   @default("/placeholder-news.png")
  author    String   @default("Admin")
  type      String   @default("general")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Contact {
  id              String   @id @default(cuid())
  name            String
  email           String
  subject         String   @default("")
  message         String
  purpose         String   @default("general")
  phone           String   @default("")
  company         String   @default("")
  sponsorshipType String   @default("")
  budgetRange     String   @default("")
  createdAt       DateTime @default(now())
}

model SeasonPrediction {
  id              String   @id @default(cuid())
  seasonId        String
  predictedTeamId String
  name            String
  email           String
  googleUserId    String?
  createdAt       DateTime @default(now())

  @@unique([email, seasonId])
}

model PredictionLock {
  id        String   @id @default(cuid())
  seasonId  String
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Sponsor {
  id        String   @id @default(cuid())
  name      String
  logo      String   @default("")
  website   String   @default("")
  tier      String   @default("platinum")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model SquadMember {
  id        String   @id @default(cuid())
  matchId   String
  playerId  String
  teamId    String
  role      String   @default("playing")
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}

model PracticeCloneMapping {
  id               String   @id @default(cuid())
  sourceSeasonId   String
  sourceTeamId     String
  sourcePlayerId   String
  practiceSeasonId String
  practiceTeamId   String
  practicePlayerId String
  createdAt        DateTime @default(now())

  @@index([practiceSeasonId])
  @@index([practiceTeamId])
}

model Review {
  id        String   @id @default(cuid())
  name      String
  email     String   @default("")
  city      String   @default("")
  rating    Int
  comment   String
  approved  Boolean  @default(false)
  ip        String   @default("")
  createdAt DateTime @default(now())
}

model Rating {
  id        String   @id @default(cuid())
  value     Int
  ip        String
  createdAt DateTime @default(now())

  @@unique([ip])
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, otp])
}

model GalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String   @default("")
  matchId   String?  @default("")
  seasonId  String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  type      String   @default("info")
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Quiz {
  id            String        @id @default(cuid())
  matchId       String
  match         Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  question      String
  options       String        @default("[]")
  correctAnswer String
  pointValue    Int           @default(10)
  active        Boolean       @default(true)
  attempts      QuizAttempt[]
  createdAt     DateTime      @default(now())

  @@unique([matchId])
}

model QuizAttempt {
  id              String   @id @default(cuid())
  quizId          String
  quiz            Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  name            String
  email           String
  selectedAnswer  String
  correct         Boolean
  createdAt       DateTime @default(now())

  @@unique([quizId, email])
  @@index([quizId])
}

model PotmVote {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  email     String
  name      String   @default("Anonymous")
  createdAt DateTime @default(now())

  @@unique([matchId, email])
}

model PlayerOfSeasonVote {
  id        String   @id @default(cuid())
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  email     String
  name      String   @default("Anonymous")
  createdAt DateTime @default(now())

  @@unique([seasonId, email])
  @@index([seasonId])
}

model BallEvent {
  id             String   @id @default(cuid())
  matchId        String
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  innings        Int      @default(1)
  overNumber     Int
  ballNumber     Int
  bowlerId       String
  batsmanId      String
  nonStrikerId   String   @default("")
  runs           Int      @default(0)
  extraRuns      Int      @default(0)
  extraType      String   @default("")
  wicketType     String   @default("")
  wicketPlayerId String   @default("")
  fielderId      String   @default("")
  isFour         Boolean  @default(false)
  isSix          Boolean  @default(false)
  commentary     String   @default("")
  total          Int      @default(0)
  createdAt      DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  email     String   @default("")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model MomentOfTheDay {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  imageUrl    String   @default("")
  link        String   @default("")
  type        String   @default("highlight")
  active      Boolean  @default(true)
  date        DateTime @unique
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String   @default("")
  details   String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  metadata  String   @default("{}")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
  @@index([event, createdAt])
}

model SuperOverInnings {
  id               String  @id @default(cuid())
  matchId          String
  match            Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  superOverNumber  Int
  teamId           String
  battingTeamId    String
  bowlingTeamId    String
  runs             Int     @default(0)
  wickets          Int     @default(0)
  balls            Int     @default(0)
  extras           Int     @default(0)
  ballsData        String  @default("[]")
  isCompleted      Boolean @default(false)
  isWinner         Boolean @default(false)
  result           String  @default("")
  createdAt        DateTime @default(now())

  @@unique([matchId, superOverNumber, teamId])
  @@index([matchId])
  @@index([teamId])
}

model SeasonSnapshot {
  id              String   @id @default(cuid())
  seasonId        String
  season          Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  matchId         String
  matchNo         Int      @default(0)
  pointsTable     Json     @default("[]")
  orangeCap       Json     @default("[]")
  purpleCap       Json     @default("[]")
  records         Json     @default("{}")
  createdAt       DateTime @default(now())

  @@unique([seasonId, matchId])
  @@index([seasonId])
  @@index([matchId])
}

model MatchNotes {
  id              String   @id @default(cuid())
  matchId         String
  match           Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  weather         String   @default("")
  temperature     String   @default("")
  pitchType       String   @default("")
  groundCondition String   @default("")
  delayReason     String   @default("")
  delayDuration   String   @default("")
  refereeNotes    String   @default("")
  injuryNotes     String   @default("")
  replacements    String   @default("")
  fines           String   @default("")
  incidents       String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([matchId])
  @@index([matchId])
}

model PlayerTransfer {
  id           String   @id @default(cuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  seasonId     String
  season       Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  fromTeamId   String   @default("")
  toTeamId     String
  transferDate DateTime @default(now())
  reason       String   @default("")
  createdAt    DateTime @default(now())

  @@index([playerId])
  @@index([seasonId])
  @@index([toTeamId])
}

model TeamCaptaincy {
  id            String   @id @default(cuid())
  seasonId      String
  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  captainId     String
  viceCaptainId String   @default("")
  createdAt     DateTime @default(now())

  @@unique([seasonId, teamId])
  @@index([teamId])
}

model LeaguePenalty {
  id          String   @id @default(cuid())
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matchId     String   @default("")
  type        String   @default("fine")
  points      Int      @default(0)
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([seasonId])
  @@index([teamId])
}

model SeasonAward {
  id        String   @id @default(cuid())
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  category  String
  playerId  String   @default("")
  teamId    String   @default("")
  value     String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())

  @@unique([seasonId, category])
  @@index([seasonId])
}

model FairPlayRecord {
  id            String   @id @default(cuid())
  seasonId      String
  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  warnings      Int      @default(0)
  behavior      Int      @default(0)
  sportsmanship Int      @default(10)
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([seasonId, teamId])
  @@index([seasonId])
}

model TeamHonor {
  id        String   @id @default(cuid())
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title     String
  note      String   @default("")
  createdAt DateTime @default(now())

  @@unique([seasonId, teamId, title])
  @@index([teamId])
}

model SeasonQuiz {
  id            String              @id @default(cuid())
  seasonId      String
  season        Season              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  question      String
  options       String              @default("[]")
  correctAnswer String
  position      Int                 @default(0)
  pointValue    Int                 @default(10)
  active        Boolean             @default(true)
  attempts      SeasonQuizAttempt[]
  createdAt     DateTime            @default(now())

  @@unique([seasonId, position])
  @@index([seasonId])
}

model SeasonQuizAttempt {
  id             String     @id @default(cuid())
  seasonQuizId   String
  seasonQuiz     SeasonQuiz @relation(fields: [seasonQuizId], references: [id], onDelete: Cascade)
  name           String
  email          String
  answers        String     @default("[]")
  score          Int        @default(0)
  total          Int        @default(0)
  createdAt      DateTime   @default(now())

  @@unique([seasonQuizId, email])
  @@index([seasonQuizId])
}

model SeasonQuizStanding {
  id        String   @id @default(cuid())
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name      String
  isHidden  Boolean  @default(false)
  isShown   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([seasonId, name])
  @@index([seasonId])
}
