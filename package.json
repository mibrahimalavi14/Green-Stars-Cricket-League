{
  "name": "green-stars-cricket-league",
  "version": "1.3.40",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "dress:rehearsal": "tsx scripts/dress-rehearsal-runner.ts",
    "backup:db": "node --env-file=.env scripts/backup-db.mjs daily",
    "backup:weekly": "node --env-file=.env scripts/backup-db.mjs weekly",
    "backup:monthly": "node --env-file=.env scripts/backup-db.mjs monthly",
    "restore:db": "node --env-file=.env scripts/restore-backup.mjs",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^6.0.0",
    "@types/web-push": "^3.6.4",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.0.0",
    "lucide-react": "^0.460.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.0",
    "nodemailer": "^7.0.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-google-recaptcha": "^3.1.0",
    "react-markdown": "^10.1.0",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-google-recaptcha": "^2.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.0.0",
    "typescript": "^5"
  }
}
